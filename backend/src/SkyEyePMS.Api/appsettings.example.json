{
  "_说明": "复制为 appsettings.json 或用环境变量覆盖（.NET 标准双下划线约定）：Database__ConnectionString、Security__EncryptionKey、Jwt__SecretKey、Seed__AdminPassword",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "mysql",
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=skyeyepms;User ID=skyeye;Password=your_db_password;CharSet=utf8mb4;",
    "SqlitePath": "data/skyeyepms.db"
  },
  "Polling": {
    "Enabled": true,
    "IntervalMinutes": 2,
    "Concurrency": 20
  },
  "Snmp": {
    "TimeoutMs": 2500,
    "DiscoverTimeoutMs": 1200,
    "DiscoverConcurrency": 50,
    "Retries": 1
  },
  "Security": {
    "EncryptionKey": "请设置为一串随机文本（用于加密 SNMP Community 等敏感字段，更换将导致旧数据无法解密）",
    "LoginRateLimit": 10,
    "GlobalRateLimit": 600
  },
  "Jwt": {
    "Issuer": "SkyEyePMS",
    "Audience": "SkyEyePMS",
    "SecretKey": "请设置为 32 位以上随机文本",
    "ExpireHours": 12
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "首次启动建库时使用的管理员密码；留空则随机生成并打印到控制台日志"
  },
  "Notifiers": {
    "Feishu": {
      "Enabled": false,
      "WebhookUrl": "https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx",
      "Secret": "如开启签名校验则填写，否则留空"
    },
    "DingTalk": {
      "Enabled": false,
      "WebhookUrl": "https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx",
      "Secret": "SECxxxxxxxx（加签方式必填；关键词方式留空）"
    },
    "WeCom": {
      "Enabled": false,
      "WebhookUrl": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx"
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 465,
      "UseSsl": true,
      "Username": "alert@example.com",
      "Password": "SMTP 密码或授权码",
      "FromAddress": "alert@example.com",
      "FromName": "SkyEyePMS",
      "ToAddresses": ["ops@example.com"]
    }
  }
}
